@page
@model FUNewsManagementSystem2.Pages.Auth.Login

@{
    ViewData["Title"] = "Login";
}
<div class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="login-container p-4 bg-white rounded shadow w-75">
        <h3 class="text-center mb-4">Login</h3>

        @if (ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger">
                @foreach (var error in ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="LoginRequest.Email" class="form-label">Email</label>
                <input asp-for="LoginRequest.Email" class="form-control" placeholder="Enter email" autocomplete="off"/>
                <span asp-validation-for="LoginRequest.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LoginRequest.Password" class="form-label">Password</label>
                <input asp-for="LoginRequest.Password" type="password" class="form-control" placeholder="Enter password" id="password" autocomplete="off"/>
                <span asp-validation-for="LoginRequest.Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" id="showPassword" />
                <label class="form-check-label" for="showPassword">Show Password</label>
            </div>

            <button type="submit" class="btn btn-primary w-100">SIGN IN</button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        // Toggle Show Password
        $(document).ready(function () {
            $('#showPassword').on('change', function () {
                const passwordField = $('#password');
                const type = $(this).is(':checked') ? 'text' : 'password';
                passwordField.attr('type', type);
            });
        });
    </script>
}
