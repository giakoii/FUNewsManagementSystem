@page
@model FUNewsManagementSystem2.Pages.Admin.Report
@{
    ViewData["Title"] = "News Report Dashboard";
}

<h2>@ViewData["Title"]</h2>

<form method="get">
    <div class="form-group">
        <label for="startDate">Start Date</label>
        <input type="date" class="form-control" id="startDate" asp-for="StartDate" required />
    </div>
    <div class="form-group">
        <label for="endDate">End Date</label>
        <input type="date" class="form-control" id="endDate" asp-for="EndDate" required />
    </div>
    <button type="submit" class="btn btn-primary mt-3">Get Report</button>
</form>

<div class="row mt-4">
    <!-- Pie Chart for Categories -->
    <div class="col-md-4">
        <canvas id="categoryChart"></canvas>
    </div>

    <!-- User Count -->
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">Total Users</h5>
                <h3>@Model.TotalUsers</h3>
            </div>
        </div>
    </div>


    <div class="col-md-4">
        <canvas id="newsChart"></canvas>
    </div>
</div>


@if (Model.NewsArticles.Any())
{
    <table class="table table-striped mt-4">
        <thead>
            <tr>
                <th>Title</th>
                <th>Created Date</th>
                <th>Content</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var article in Model.NewsArticles)
            {
                <tr>
                    <td>@article.NewsTitle</td>
                    <td>@article.CreatedDate?.ToString("yyyy-MM-dd")</td>
                    <td>@article.NewsContent</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="mt-4">No news articles found for the specified date range.</p>
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
      
        var articles = @Html.Raw(Json.Serialize(Model.NewsArticles));
        var monthlyLabels = [];
        var monthlyDataCounts = {};

        console.log("Articles data:", articles); 

        articles.forEach(article => {
            if (article.createdDate) { 
                let date = new Date(article.createdDate);
                if (!isNaN(date.getTime())) { // Đảm bảo date hợp lệ
                    let monthYear = date.getFullYear() + '-' + (date.getMonth() + 1).toString().padStart(2, '0');
                    monthlyDataCounts[monthYear] = (monthlyDataCounts[monthYear] || 0) + 1;
                } else {
                    console.log("Invalid date found:", article.createdDate);
                }
            }
        });

        monthlyLabels = Object.keys(monthlyDataCounts).sort();
        var monthlyDataValues = monthlyLabels.map(date => monthlyDataCounts[date]);



        var monthlyCtx = document.getElementById('newsChart').getContext('2d');
        new Chart(monthlyCtx, {
            type: 'bar',
            data: {
                labels: monthlyLabels,
                datasets: [{
                    label: 'Articles per Month',
                    data: monthlyDataValues,
                    backgroundColor: 'rgba(54, 162, 235, 0.6)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        title: { display: true, text: 'Number of Articles' }
                    },
                    x: {
                        title: { display: true, text: 'Month' }
                    }
                }
            }
        });

       
        var categoryData = @Html.Raw(Json.Serialize(Model.CategoryStats));
        if (categoryData && categoryData.length > 0) {
            var categoryCtx = document.getElementById('categoryChart').getContext('2d');
            new Chart(categoryCtx, {
                type: 'pie',
                data: {
                    labels: categoryData.map(item => item.categoryName),
                    datasets: [{
                        data: categoryData.map(item => item.articleCount),
                        backgroundColor: [
                            'rgba(255, 99, 132, 0.7)',
                            'rgba(54, 162, 235, 0.7)',
                            'rgba(255, 206, 86, 0.7)',
                            'rgba(75, 192, 192, 0.7)',
                            'rgba(153, 102, 255, 0.7)',
                            'rgba(255, 159, 64, 0.7)'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' },
                        title: { display: true, text: 'Articles by Category' }
                    }
                }
            });
        } else {
            console.log("No category data available");
        }
    });
</script>