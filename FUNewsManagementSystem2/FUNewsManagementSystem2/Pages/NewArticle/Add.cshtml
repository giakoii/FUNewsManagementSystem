@page
@model FUNewsManagementSystem2.Pages.NewArticle.Add

@{
    ViewData["Title"] = "Add New Article";
}

<h1>@ViewData["Title"]</h1>
@if (Model.Categories != null && Model.Categories.Any())
{
    @foreach (var category in Model.Categories)
    {
        <option value="@category.CategoryId">@category.CategoryName</option>
    }
}
else
{
    <option value="">No categories available</option> <!-- 🔥 Xử lý khi không có dữ liệu -->
}
<form method="post">
    <div class="mb-3">
        <label class="form-label">Title</label>
        <input asp-for="NewArticle.NewsTitle" class="form-control" required/>
    </div>

    <div class="mb-3">
        <label class="form-label">Category</label>
        <select asp-for="NewArticle.CategoryId" class="form-control">
            @if (Model.Categories != null && Model.Categories.Any())
            {
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.CategoryId">@category.CategoryName</option>
                }
            }
            else
            {
                <option value="">No categories available</option> <!-- 🔥 Tránh lỗi nếu danh sách trống -->
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Tags</label>
        <div>
            @foreach (var tag in Model.Tags)
            {
                <input type="checkbox" name="SelectedTags" value="@tag.TagId"/> @tag.TagName
            }
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>
